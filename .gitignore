# ==========================================
# 1. Node.js & Frontend (Next.js / React)
# ==========================================
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/.cache/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*


# ==========================================
# 2. Backend & Runtime Environment
# ==========================================
# Python (If backend is Python/Django/FastAPI)
**/__pycache__/
**/*.pyc
**/venv/
**/.env/

# Node.js Backend (If backend is Node.js)
**/dist/

# ==========================================
# 3. Environment Variables & Secrets (CRITICAL)
# ==========================================
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*secret*
**/*.pem
**/*.key

# ==========================================
# 4. System & Editor Files
# ==========================================
.DS_Store
Thumbs.db
**/.vscode/
**/.idea/
**/Thumbs.db
